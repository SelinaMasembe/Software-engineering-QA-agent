# Copy to .env and fill in locally:  cp .env.example .env
# Load into your terminal before a live run:  set -a; source .env; set +a
# .env is git-ignored and blocked by the pre-commit scanner. Never commit it.

# --- Model (required for --live runs only; offline tests need none of this) ---
# Google AI Studio OpenAI-compatible endpoint (must be https)
MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# The model every recorded live run used (evidence/test-runs/week8/).
# Confirm it is still available in Google AI Studio before running.
MODEL_NAME=gemini-2.5-flash

# Replace locally. Never commit a real API key.
MODEL_API_KEY=replace-with-your-google-ai-studio-key

# Optional (defaults shown). Timeout must be 0-600 s; max tokens 1-65536.
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=1200
MODEL_JSON_MODE=true

# --- Human approval and memory commands ---
# Role or team handles allowed to approve tools, reject proposals and clear memory
# (scripts/approve_cli.py, python -m memory.retention clear-module). Not personal emails.
QA_AGENT_APPROVERS=qa-lead,team-j

# --- Optional locations (defaults shown; all relative to the repository) ---
# QA_AGENT_DATA_DIR=data                          # approval queue and audit log
# QA_AGENT_MEMORY_PATH=data/memory.sqlite3        # memory database
# QA_AGENT_MEMORY_AUDIT_PATH=data/memory_audit.jsonl
# QA_AGENT_TRACE_DIR=evidence/traces/runs         # run logs (RunLogger)
# QA_AGENT_OBSERVABILITY_DIR=evidence/traces/observability   # step telemetry
