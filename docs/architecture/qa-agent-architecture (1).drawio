        <mxCell id="sys" parent="sysz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;b&gt;QA Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;Grounds itself in a frozen repository, proposes tests, runs approved existing tests in a sandbox, explains failures, drafts an issue or PR note.&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="500" x="30" y="34" as="geometry" />
        </mxCell>
        <mxCell id="extz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=11;fontStyle=1;dashed=1;dashPattern=6 4;fillColor=#f6f7f9;strokeColor=#767d8c;fontColor=#454b57;" value="EXTERNAL SYSTEMS" vertex="1">
