        <mxCell id="sys" parent="sysz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;b&gt;QA Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;Grounds itself in a frozen repository, proposes tests, runs approved existing tests in a sandbox, explains failures, drafts an issue or PR note.&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="500" x="30" y="34" as="geometry" />
        </mxCell>
        <mxCell id="extz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=11;fontStyle=1;dashed=1;dashPattern=6 4;fillColor=#f6f7f9;strokeColor=#767d8c;fontColor=#454b57;" value="EXTERNAL SYSTEMS" vertex="1">
          <mxGeometry height="200" width="1080" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="llm" parent="extz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#ffffff;strokeColor=#454b57;fontColor=#16181d;" value="&lt;b&gt;LLM provider API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;UNTRUSTED OUTPUT. Reasoning and drafting. Returns text and tool-call requests.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="24" y="40" as="geometry" />
        </mxCell>
        <mxCell id="repo" parent="extz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#ffffff;strokeColor=#454b57;fontColor=#16181d;" value="&lt;b&gt;Frozen target repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#767d8c&quot;&gt;READ ONLY. Requirements, docs, source, existing tests, past issues. Pinned at a tag. Prompt-injection surface.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="286" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sbx" parent="extz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" value="&lt;b&gt;Sandbox runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;UNTRUSTED EXECUTION. Disposable container. Allow-listed test node IDs, no network, no credentials, hard timeout.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="548" y="40" as="geometry" />
        </mxCell>
        <mxCell id="gh" parent="extz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;GitHub API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;WRITE, HUMAN-GATED. Issue and PR-note creation. One repository, issues:write only.&lt;/font&gt;" vertex="1">
