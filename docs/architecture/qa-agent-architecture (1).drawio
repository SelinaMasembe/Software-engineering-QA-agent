        <mxCell id="dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=center;verticalAlign=middle;spacing=4;fillColor=#ffffff;strokeColor=#454b57;fontColor=#16181d;" value="&lt;b&gt;QA engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#767d8c&quot;&gt;Primary user. Opens a triage request, approves test scope, reviews and posts the drafted note.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="320" x="420" y="90" as="geometry" />
