        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="dev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#767d8c;fontSize=10;fontColor=#454b57;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.343;exitY=1.006;exitDx=0;exitDy=0;exitPerimeter=0;" target="sysz" value="goal, approval decisions">
