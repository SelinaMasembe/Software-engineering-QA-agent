        <mxCell id="sysz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=11;fontStyle=1;dashed=0;fillColor=#ffffff;strokeColor=#454b57;fontColor=#454b57;" value="SYSTEM IN SCOPE" vertex="1">
          <mxGeometry height="150" width="560" x="300" y="240" as="geometry" />
